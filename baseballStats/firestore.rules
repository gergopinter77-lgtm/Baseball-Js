rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Friendship documents are named "smallerUid_biggerUid"
    function friendshipPath(a, b) {
      return /databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a);
    }

    function isFriendOf(uid) {
      return request.auth != null && exists(friendshipPath(request.auth.uid, uid))
        && get(friendshipPath(request.auth.uid, uid)).data.status == 'accepted';
    }

    // A comment's player rating: who, from which team, and 1-5 whole stars
    function isValidRating(r) {
      return r is map
        && r.keys().hasOnly(['playerId', 'playerName', 'teamId', 'stars'])
        && r.playerId is int
        && r.playerName is string && r.playerName.size() <= 100
        && r.teamId is int
        && r.stars is int && r.stars >= 1 && r.stars <= 5;
    }

    // Match discussions: logged in users read and write, as themselves, in plain text
    match /matches/{gamePk}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'rating'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500
                    // No HTML tags, even if someone skips the app's own cleaning
                    && !request.resource.data.text.matches('(?s).*<[a-zA-Z/!][^>]*>.*')
                    // Text, a rating, or both
                    && (request.resource.data.text.size() > 0 || 'rating' in request.resource.data)
                    && (!('rating' in request.resource.data) || isValidRating(request.resource.data.rating));
      // Comments can't be edited; the writer or an admin can delete them
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Public profiles (no email): readable by any logged in user
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAdmin())
                    && request.resource.data.keys().hasOnly(['displayName', 'nameLower', 'photoURL', 'bio',
                         'favouritePlayers', 'favouriteTeams'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 100
                    && request.resource.data.nameLower is string
                    && (!('bio' in request.resource.data) || (request.resource.data.bio is string
                         && request.resource.data.bio.size() <= 500))
                    && (!('favouritePlayers' in request.resource.data) || (request.resource.data.favouritePlayers is list
                         && request.resource.data.favouritePlayers.size() <= 100))
                    && (!('favouriteTeams' in request.resource.data) || (request.resource.data.favouriteTeams is list
                         && request.resource.data.favouriteTeams.size() <= 100));
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // One document per pair of users: a pending request, or friends once accepted
    match /friendships/{id} {
      // Only the two people in it can see it
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      // Send a request: from yourself, pending, under the right document id
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['users', 'requester', 'status', 'createdAt'])
                    && request.resource.data.users is list
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users[0] < request.resource.data.users[1]
                    && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
                    && request.resource.data.requester == request.auth.uid
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;
      // Accept: only the person who got the request, and only from pending to accepted
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.users
                    && request.auth.uid != resource.data.requester
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.acceptedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      // Decline, cancel or unfriend: either of the two
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    match /users/{uid} {
      // You can read your own profile; admins can read everyone
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // New accounts can only create their own profile, and never as admin
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'user';
      // You can change your own name, bio and picture, but not your role
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'bio', 'photoURL']));
      // Only admins can delete accounts
      allow delete: if isAdmin();
    }

    // "Who will win?" polls: one vote per account per match, saved under the voter's uid
    match /polls/{gamePk}/votes/{uid} {
      // You can always check your own vote (to see if you voted yet)
      allow get: if request.auth != null && request.auth.uid == uid;
      // Results (all votes) only once you have voted yourself
      allow list: if request.auth != null &&
        exists(/databases/$(database)/documents/polls/$(gamePk)/votes/$(request.auth.uid));
      // One vote per account, never changed
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['teamId', 'createdAt'])
                    && request.resource.data.teamId is int
                    && request.resource.data.createdAt == request.time;
    }

    // Fantasy teams: you and your friends can see it, only you can change it
    match /fantasy/{season}/teams/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isFriendOf(uid));
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['picks', 'updatedAt'])
                    && request.resource.data.picks is map
                    && request.resource.data.picks.size() <= 15
                    && request.resource.data.updatedAt == request.time;
    }
  }
}
