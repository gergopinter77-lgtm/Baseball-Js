rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // You can read your own profile; admins can read everyone
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // New accounts can only create their own profile, and never as admin
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'user';
      // You can change your own name, bio and picture, but not your role
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'bio', 'photoURL']));
      // Only admins can delete accounts
      allow delete: if isAdmin();
    }

    // "Who will win?" polls: one vote per account per match, saved under the voter's uid
    match /polls/{gamePk}/votes/{uid} {
      // You can always check your own vote (to see if you voted yet)
      allow get: if request.auth != null && request.auth.uid == uid;
      // Results (all votes) only once you have voted yourself
      allow list: if request.auth != null &&
        exists(/databases/$(database)/documents/polls/$(gamePk)/votes/$(request.auth.uid));
      // Vote once, for yourself, with only a team id and the server time. No changing it afterwards.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['teamId', 'createdAt'])
                    && request.resource.data.teamId is int
                    && request.resource.data.createdAt == request.time;
    }

    // Fantasy teams: one per account per season, only you can see or change yours
    match /fantasy/{season}/teams/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['picks', 'updatedAt'])
                    && request.resource.data.picks is map
                    && request.resource.data.picks.size() <= 15
                    && request.resource.data.updatedAt == request.time;
    }
  }
}
